<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.dam.jobtrack.controller.ContactosController"
            stylesheets="@estilos.css" prefWidth="1040" prefHeight="650">
    <padding><Insets top="22" right="24" bottom="20" left="24"/></padding>
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="Contactos profesionales" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Cerrar" styleClass="btn-secondary" onAction="#cerrar" cancelButton="true"/>
        </HBox>
    </top>
    <center>
        <HBox spacing="18">
            <BorderPane.margin><Insets top="18" bottom="12"/></BorderPane.margin>
            <VBox spacing="12" HBox.hgrow="ALWAYS">
                <Button text="+ Nuevo contacto" styleClass="btn-primary" onAction="#nuevo"/>
                <TableView fx:id="tabla" VBox.vgrow="ALWAYS" accessibleText="Contactos registrados">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colNombre" text="Nombre" prefWidth="155"/>
                        <TableColumn fx:id="colEmpresa" text="Empresa" prefWidth="125"/>
                        <TableColumn fx:id="colPuesto" text="Puesto" prefWidth="140"/>
                        <TableColumn fx:id="colEmail" text="Correo" prefWidth="175"/>
                    </columns>
                    <placeholder><Label text="No hay contactos que mostrar."/></placeholder>
                </TableView>
                <Button fx:id="borrar" text="Borrar contacto" styleClass="btn-danger" onAction="#borrar"/>
            </VBox>
            <ScrollPane fitToWidth="true" minWidth="290" prefWidth="350">
                <VBox spacing="6">
                    <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
                    <Label fx:id="titulo" text="Nuevo contacto" style="-fx-font-size: 17px; -fx-font-weight: bold;"/>
                    <Label text="Nombre *"/>
                    <TextField fx:id="nombre" accessibleText="Nombre completo del contacto"/>
                    <Label text="Correo electrónico *"/>
                    <TextField fx:id="email" accessibleText="Correo electrónico"/>
                    <Label text="Teléfono"/>
                    <TextField fx:id="telefono" accessibleText="Teléfono"/>
                    <Label text="Empresa *"/>
                    <ComboBox fx:id="empresa" accessibleText="Empresa del contacto" maxWidth="Infinity"/>
                    <Label text="Puesto"/>
                    <TextField fx:id="puesto" accessibleText="Puesto"/>
                    <Label text="Fecha del último contacto *"/>
                    <DatePicker fx:id="fechaContacto" editable="false" maxWidth="Infinity" accessibleText="Fecha del último contacto"/>
                    <Label text="Notas"/>
                    <TextArea fx:id="notas" prefRowCount="2" wrapText="true" accessibleText="Notas del contacto"/>
                    <Button fx:id="guardar" text="Guardar" styleClass="btn-primary" onAction="#guardar"/>
                </VBox>
            </ScrollPane>
        </HBox>
    </center>
    <bottom><Label fx:id="aviso" wrapText="true"/></bottom>
</BorderPane>

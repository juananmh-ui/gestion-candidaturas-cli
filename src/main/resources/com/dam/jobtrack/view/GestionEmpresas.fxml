<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.dam.jobtrack.controller.GestionEmpresasController"
            stylesheets="@estilos.css" prefWidth="1000" prefHeight="570">
    <padding>
        <Insets top="22" right="24" bottom="20" left="24"/>
    </padding>
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label fx:id="encabezado" text="Gestión de empresas" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" wrapText="true"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Cerrar" styleClass="btn-secondary" onAction="#cerrar"/>
        </HBox>
    </top>
    <center>
        <HBox spacing="18">
            <BorderPane.margin>
                <Insets top="18" bottom="12"/>
            </BorderPane.margin>
            <VBox spacing="12" HBox.hgrow="ALWAYS">
                <HBox spacing="8">
                    <TextField fx:id="buscar" promptText="Filtrar por nombre o sector" HBox.hgrow="ALWAYS"
                               accessibleText="Filtrar empresas por nombre o sector"/>
                    <Button text="Limpiar" styleClass="btn-secondary" onAction="#limpiarBusqueda"
                            accessibleText="Limpiar el filtro de empresas"/>
                    <Button text="+ Nueva empresa" styleClass="btn-primary" onAction="#nueva"/>
                </HBox>
                <TableView fx:id="tabla" VBox.vgrow="ALWAYS" minWidth="398">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colNombre" text="Empresa" prefWidth="190"/>
                        <TableColumn fx:id="colSector" text="Sector" prefWidth="160"/>
                        <TableColumn fx:id="colFecha" text="Fecha de registro" prefWidth="135"/>
                    </columns>
                    <placeholder>
                        <Label fx:id="sinResultados"/>
                    </placeholder>
                </TableView>
                <Button fx:id="borrar" text="Borrar empresa" styleClass="btn-danger" onAction="#borrar"/>
            </VBox>
            <VBox spacing="8" prefWidth="325" minWidth="275"
                  style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8;">
                <padding>
                    <Insets top="16" right="16" bottom="16" left="16"/>
                </padding>
                <Label fx:id="tituloFormulario" text="Nueva empresa"
                       style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
                <Label text="Nombre *"/>
                <TextField fx:id="nombre" accessibleText="Nombre de la empresa"/>
                <Label text="Sector"/>
                <TextField fx:id="sector" accessibleText="Sector"/>
                <Label text="Web"/>
                <TextField fx:id="web" promptText="https://…" accessibleText="Sitio web"/>
                <Label text="Fecha de registro *"/>
                <DatePicker fx:id="fecha" editable="false" maxWidth="Infinity" accessibleText="Fecha de registro"/>
                <Button text="Guardar" styleClass="btn-primary" onAction="#guardar"/>
            </VBox>
        </HBox>
    </center>
    <bottom>
        <Label fx:id="aviso" wrapText="true" style="-fx-text-fill: #334155;"/>
    </bottom>
</BorderPane>

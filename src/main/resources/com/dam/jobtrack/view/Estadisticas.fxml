<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.dam.jobtrack.controller.EstadisticasController"
      stylesheets="@estilos.css" prefWidth="900" prefHeight="550" spacing="14">
    <padding><Insets top="22" right="24" bottom="22" left="24"/></padding>
    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label text="Estadísticas de candidaturas" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="actualizar" onAction="#cargar" styleClass="btn-primary" text="Actualizar"/>
        <Button onAction="#cerrar" styleClass="btn-secondary" text="Cerrar" cancelButton="true"/>
    </HBox>
    <Label fx:id="resumen" wrapText="true" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
            <Tab text="Por empresa">
                <TableView fx:id="empresas" accessibleText="Candidaturas por empresa">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="empresa" text="Empresa" prefWidth="510"/>
                        <TableColumn fx:id="totalEmpresa" text="Candidaturas" prefWidth="170"/>
                    </columns>
                    <placeholder><Label text="No hay candidaturas que mostrar."/></placeholder>
                </TableView>
            </Tab>
            <Tab text="Por estado">
                <TableView fx:id="estados" accessibleText="Candidaturas por estado">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="estado" text="Estado" prefWidth="510"/>
                        <TableColumn fx:id="totalEstado" text="Candidaturas" prefWidth="170"/>
                    </columns>
                    <placeholder><Label text="No hay candidaturas que mostrar."/></placeholder>
                </TableView>
            </Tab>
            <Tab text="Por mes">
                <TableView fx:id="meses" accessibleText="Candidaturas por mes">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="mes" text="Mes de postulación" prefWidth="510"/>
                        <TableColumn fx:id="totalMes" text="Candidaturas" prefWidth="170"/>
                    </columns>
                    <placeholder><Label text="No hay candidaturas que mostrar."/></placeholder>
                </TableView>
            </Tab>
        </tabs>
    </TabPane>
    <Label fx:id="aviso" wrapText="true"/>
</VBox>
